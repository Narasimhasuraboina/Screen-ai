# ScreenAI Backend Configuration Example
# Copy this to .env in your root or apps/api directory

# Server Configuration
PORT=3001
NODE_ENV=development

# Allowed Web Origins (comma-separated or single)
WEB_ORIGIN=http://localhost:5173

# Optional: Specific Extension ID (if empty, allows chrome-extension:// origins in development)
EXTENSION_ID=

# AI Provider Configuration
# Supported providers: "openai" | "gemini" | "anthropic" | "mock"
# If AI_API_KEY is not set or set to "mock", the backend operates in deterministic intelligent mock mode
AI_PROVIDER=openai

# Provider API Key (Keep secret! Never commit this file or expose in client builds)
AI_API_KEY=your_ai_api_key_here

# Model name (e.g., "gpt-4o-mini", "gpt-4o", "gemini-1.5-flash", "claude-3-5-sonnet-20241022")
AI_MODEL=gpt-4o-mini

# Optional Custom Base URL (e.g. for Ollama, Groq, OpenRouter, or DeepSeek)
AI_BASE_URL=https://api.openai.com/v1

# Security & Limits
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
MAX_CONTENT_CHARS=60000

